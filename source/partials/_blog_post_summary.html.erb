<div class="post-summary">
  <a href="<%= article.url %>" class="post-link">
  <div class="blog-user-details">
    <figure class="post-summary-image">
      <img src= "<%= article.data["summary_image"] %>" alt="<%= article.title %>" />
    </figure>
    <h3><img src="<%= article.data['author_image'] %>" alt="<%= article.data['author_name'] %>" class="profile-image">
        <%= !article.data['second_author_image'].blank? ?
        "<img src="+article.data['second_author_image']+" alt="+article.data['author_name']+" class='profile-image second_author_image' />"
        : '' 
        %>
        <%= !article.data['second_author_name'].blank? ?
          article.data['author_name'] + " & " + article.data['second_author_name']
          :
          article.data['author_name']
        %>
    </h3>
  </div>
  </a>
  <div class="blog-details">
    <a href="<%= article.url %>" class="post-link">
      <span class="post-date"><%= article.date.strftime('%b %e, %Y') %></span>
      <h2 class="post-title"><%= (article.data.post_title) %></h2>
      <p class="excerpt"><%= article.data["excerpt"] %> </p>
    </a>
  </div>
  
</div>